# Supabase (Project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key. Server-only — never exposed to the browser. Required
# for admin operations (e.g. inviting scouts via auth.admin in Phase 2).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used for absolute URLs (OG images, magic-link redirects, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dev-only auth bypass. When set to "1", the auth pages render a panel
# offering one-click sign-in as a pre-confirmed scout or admin —
# no email verification required. Hard-disabled in production builds.
# Requires SUPABASE_SERVICE_ROLE_KEY above.
NEXT_PUBLIC_DEV_AUTH_BYPASS=1

# --- Free Football & Player APIs ---
# TheSportsDB: Free test API key is "3" (built-in fallback). Get a free Patreon/supporter key for higher throughput.
THESPORTSDB_API_KEY=3

# API-Football (api-sports.io / RapidAPI): Free tier provides 100 requests/day for African leagues, squads, and player data.
# API_FOOTBALL_KEY=your-api-football-key

# Football-Data.org: Free forever tier provides 12 major competitions, standings, and rosters (10 req/min).
# FOOTBALL_DATA_KEY=your-football-data-token
